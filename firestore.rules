rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MVP rule set: only Firebase-authenticated users may access game data.
    // The app signs users in anonymously, so there is no account/password UI.
    // Game codes are random and should be treated as invitations.
    match /games/{gameId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null;

      match /players/{playerId} {
        allow read, write: if request.auth != null;
      }

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null;
      }

      match /properties/{propertyId} {
        allow read, write: if request.auth != null;
      }

      match /privateMessages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
